# Copy to .env and fill in. Do not commit .env.
# Placeholders only except the public UPI defaults, which the app also has built in.

PORT=3000
HOST=127.0.0.1
SESSION_SECRET=
APP_URL=http://127.0.0.1:3000

# Postgres / Neon. Leave empty to use data/kv.json on one machine.
DATABASE_URL=
DATABASE_SCHEMA=

# AI. The owner brings their own key in the app. A server key is only for the sample when the flag below is set.
AI_PROVIDER=
AI_MOCK=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Cheap model for drafts and reminders. Stronger model for Chief.
AI_MODEL_CHEAP=
AI_MODEL_STRONG=

# Sample clinic / agency on staging only.
CLINIC_DEMO=
CLINIC_DEMO_PLATFORM_KEY=

# UPI for AaaS plans. Leave empty to use the built-in PhonePe ID and payee.
UPI_ID=
UPI_PAYEE=
UPI_QR_PATH=
ONBOARD_WHATSAPP=
ONBOARD_EMAIL=
GRIEVANCE_NAME=
GRIEVANCE_PHONE=
GRIEVANCE_EMAIL=

# WhatsApp. QR needs a long-running worker (node worker.js). Vercel cannot hold the socket.
# Official Cloud API is optional: set CLINIC_WA_PROVIDER=meta or gupshup and the matching keys.
WHATSAPP_QR=
CLINIC_WA_PROVIDER=
CLINIC_WA_META_TOKEN=
CLINIC_WA_META_PHONE_ID=
CLINIC_WA_META_APP_SECRET=

# Composio. Webhook token may be sent as X-AaaS-Trigger-Token. Do not put new secrets in query strings.
COMPOSIO_API_KEY=

CRON_SECRET=
RATE_LIMIT=
